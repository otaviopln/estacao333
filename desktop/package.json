{
  "name": "estacao-333-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Estação 3:33 — versão desktop (Electron + Steamworks) para a Steam.",
  "author": "Equipe Estação 3:33",
  "main": "main.js",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "start": "npm run prepare:app && electron .",
    "dist:win": "npm run prepare:app && electron-builder --win dir --x64",
    "dist:linux": "npm run prepare:app && electron-builder --linux dir --x64",
    "dist:mac": "npm run prepare:app && electron-builder --mac dir --universal"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "com.estacao333.game",
    "productName": "Estacao 333",
    "copyright": "Estação 3:33",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "preload.js", "steam.js", "steam-config.json", "app/**/*", "package.json"],
    "asar": true,
    "asarUnpack": ["**/node_modules/steamworks.js/**"],
    "electronLanguages": ["pt-BR", "en-US"],
    "win": { "icon": "build/icon.png", "target": [{ "target": "dir", "arch": ["x64"] }] },
    "linux": { "icon": "build/icon.png", "category": "Game", "target": [{ "target": "dir", "arch": ["x64"] }] },
    "mac": { "icon": "build/icon.png", "category": "public.app-category.games", "target": [{ "target": "dir", "arch": ["universal"] }] }
  }
}
